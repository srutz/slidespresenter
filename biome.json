{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"src/**",
			"*.ts",
			"*.json"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 1,
		"indentStyle": "tab"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "error",
				"noUnusedImports": "warn"
			},
			"style": {
				"useComponentExportOnlyModules": {
					"level": "warn",
					"options": {
						"allowConstantExport": true
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/components/ui/**"
			],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		}
	]
}